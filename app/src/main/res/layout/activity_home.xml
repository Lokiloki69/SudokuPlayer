<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false">

    <ImageView
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-70dp"
        android:alpha="0.05"
        android:contentDescription="@null"
        android:src="@drawable/ic_mini_board"
        app:tint="@color/md_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/adContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_l">

            <FrameLayout
                android:id="@+id/layoutLogo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_chip_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_grid"
                    app:tint="@color/md_on_primary_container" />

            </FrameLayout>

            <TextView
                android:id="@+id/textAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.SudokuPlayer.DisplayTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutLogo" />

            <TextView
                android:id="@+id/textAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/home_subtitle"
                android:textAppearance="@style/TextAppearance.SudokuPlayer.ScreenSubtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textAppTitle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContinueGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:visibility="gone"
                app:cardBackgroundColor="@color/md_primary_container"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textAppSubtitle"
                app:rippleColor="@color/md_primary"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:id="@+id/textContinueLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/action_continue_game"
                        android:textAppearance="@style/TextAppearance.SudokuPlayer.CardTitle"
                        android:textColor="@color/md_on_primary_container"
                        app:layout_constraintEnd_toStartOf="@id/imageContinueBoard"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textContinueDifficulty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.SudokuPlayer.CardBody"
                        android:textColor="@color/md_on_primary_container"
                        app:layout_constraintEnd_toStartOf="@id/imageContinueBoard"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textContinueLabel"
                        tools:text="Medium · 04:12 elapsed" />

                    <ImageView
                        android:id="@+id/imageContinueBoard"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mini_board"
                        app:tint="@color/md_on_primary_container"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressContinue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        app:indicatorColor="@color/md_primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textContinueDifficulty"
                        app:trackColor="@color/md_primary_container"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp"
                        tools:progress="45" />

                    <TextView
                        android:id="@+id/textContinueProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.SudokuPlayer.StatLabel"
                        android:textColor="@color/md_on_primary_container"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressContinue"
                        tools:text="45% complete" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonContinue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:backgroundTint="@color/md_primary"
                        android:text="@string/action_continue_game"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_primary"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:icon="@drawable/ic_play_arrow"
                        app:iconTint="@color/md_on_primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textContinueProgress" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNewGame"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/action_new_game"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.SudokuPlayer.ChipLabel"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius"
                app:icon="@drawable/ic_add"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardContinueGame" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatistics"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginEnd="@dimen/spacing_s"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintDimensionRatio="1:0.82"
                app:layout_constraintEnd_toStartOf="@id/cardSettings"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/buttonNewGame"
                app:rippleColor="@color/md_secondary"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_chip_secondary">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bar_chart"
                            app:tint="@color/md_on_secondary_container" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:text="@string/action_statistics"
                        android:textAppearance="@style/TextAppearance.SudokuPlayer.CardTitle"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/cardStatistics"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/cardStatistics"
                app:layout_constraintTop_toTopOf="@id/cardStatistics"
                app:rippleColor="@color/md_tertiary"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_chip_tertiary">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/md_on_tertiary_container" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:text="@string/action_settings"
                        android:textAppearance="@style/TextAppearance.SudokuPlayer.CardTitle"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
    Adaptive banner ad. The AdView itself is created in code (HomeActivity.loadBannerAd) and
    added to this container - the Mobile Ads SDK requires adSize/adUnitId to be set before the
    view is attached, which an XML-declared <AdView> tag cannot satisfy in time. Background
    matches the app surface so an empty/loading slot doesn't flash white.
    -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
